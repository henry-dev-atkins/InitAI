{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-ledger.v1",
  "type": "object",
  "required": [
    "schema",
    "workstream_id",
    "plan_id",
    "manifest_path",
    "manifest_sha256",
    "status",
    "first_failed_gate",
    "repository_tree_hash_before",
    "repository_tree_hash_after",
    "runner",
    "environment",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "evidence-ledger.v1"
    },
    "workstream_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^WS[0-9]{3,}$"
        },
        {
          "const": "GLOBAL"
        }
      ]
    },
    "plan_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^P[0-9]{3,}$"
        },
        {
          "type": "string",
          "pattern": "^GVM[0-9]{3,}$"
        }
      ]
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "first_failed_gate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMD[0-9]{3,}$"
    },
    "repository_tree_hash_before": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository_tree_hash_after": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runner": {
      "type": "object",
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "run_command_manifest.py"
        },
        "version": {
          "const": "1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "python",
        "repo_root"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "repo_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv",
          "cwd",
          "expected_status",
          "requirement_ids",
          "finding_ids",
          "started_at",
          "finished_at",
          "exit_code",
          "status",
          "tree_hash_before",
          "tree_hash_after",
          "stdout_path",
          "stdout_sha256",
          "stderr_path",
          "stderr_sha256",
          "artefacts"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMD[0-9]{3,}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "expected_status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ[0-9]{3,}$"
            }
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F[0-9]{3,}$"
            }
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "tree_hash_before": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tree_hash_after": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stdout_path": {
            "type": "string",
            "minLength": 1
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr_path": {
            "type": "string",
            "minLength": 1
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "summary": {
            "type": "string"
          },
          "artefacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
