{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-ledger.v1",
  "type": "object",
  "required": ["schema", "workstream_id", "plan_id", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "evidence-ledger.v1" },
    "workstream_id": { "type": "string", "pattern": "^WS[0-9]{3}$" },
    "plan_id": { "type": "string", "pattern": "^P[0-9]{3}$" },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "first_failed_gate": { "type": ["string", "null"] },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "argv", "cwd", "exit_code", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CMD[0-9]{3}$" },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "summary": { "type": "string" },
          "artefacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
