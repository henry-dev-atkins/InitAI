{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "global-validation-manifest.v1",
  "type": "object",
  "required": ["schema", "manifest_id", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "global-validation-manifest.v1" },
    "manifest_id": { "type": "string", "pattern": "^GVM[0-9]{3,}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "argv", "cwd", "purpose", "phase", "expected_status", "timeout_seconds", "requirement_ids", "finding_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CMD[0-9]{3,}$" },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cwd": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "phase": { "const": "final-validation" },
          "expected_status": { "type": "string", "enum": ["pass", "fail"] },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
          "requirement_ids": { "type": "array", "items": { "type": "string", "pattern": "^REQ[0-9]{3,}$" } },
          "finding_ids": { "type": "array", "items": { "type": "string", "pattern": "^F[0-9]{3,}$" } },
          "artefact_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "temp_root": { "type": "string" },
          "requires_existing_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
