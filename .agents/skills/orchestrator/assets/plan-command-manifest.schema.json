{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-command-manifest.v1",
  "type": "object",
  "required": [
    "schema",
    "workstream_id",
    "plan_id",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "plan-command-manifest.v1"
    },
    "workstream_id": {
      "type": "string",
      "pattern": "^WS[0-9]{3,}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^P[0-9]{3,}$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "argv",
          "cwd",
          "purpose",
          "phase",
          "expected_status",
          "requirement_ids",
          "finding_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMD[0-9]{3,}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "pre-edit",
              "implementation-validation",
              "final-validation",
              "diagnostic"
            ]
          },
          "expected_status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^REQ[0-9]{3,}$"
            }
          },
          "finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^F[0-9]{3,}$"
            }
          },
          "artefact_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "temp_root": {
            "type": "string"
          },
          "requires_existing_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
