{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-register.v1",
  "type": "object",
  "required": ["schema", "spec_path", "spec_sha256", "line_count", "coverage", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "requirement-register.v1" },
    "spec_path": { "const": "AI_SPACE/SPEC.md" },
    "spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "line_count": { "type": "integer", "minimum": 1 },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_line", "end_line", "classification", "requirement_ids", "reason"],
        "additionalProperties": false,
        "properties": {
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "classification": { "type": "string", "enum": ["REQUIREMENT", "NON_NORMATIVE"] },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ[0-9]{3,}$" }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "summary", "spec_start_line", "spec_end_line", "text_sha256",
          "implementation_evidence", "validation_evidence", "waiver"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^REQ[0-9]{3,}$" },
          "summary": { "type": "string", "minLength": 1 },
          "spec_start_line": { "type": "integer", "minimum": 1 },
          "spec_end_line": { "type": "integer", "minimum": 1 },
          "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "implementation_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["workstream_id", "plan_id", "accepted_state_path"],
              "additionalProperties": false,
              "properties": {
                "workstream_id": { "type": "string", "pattern": "^WS[0-9]{3,}$" },
                "plan_id": { "type": "string", "pattern": "^P[0-9]{3,}$" },
                "accepted_state_path": { "type": "string", "minLength": 1 }
              }
            }
          },
          "validation_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ledger_path", "command_ids"],
              "additionalProperties": false,
              "properties": {
                "ledger_path": { "type": "string", "minLength": 1 },
                "command_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^CMD[0-9]{3,}$" }
                }
              }
            }
          },
          "waiver": {
            "type": ["object", "null"],
            "required": ["waiver_id", "authority", "reason", "expires_at"],
            "additionalProperties": false,
            "properties": {
              "waiver_id": { "type": "string", "pattern": "^WVR[0-9]{3,}$" },
              "authority": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "expires_at": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
