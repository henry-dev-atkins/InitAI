{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI workflow DSL v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "max_agents",
    "preflight",
    "independent_reviews",
    "completion",
    "nodes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "max_agents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "max_plan_rejections": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "preflight": {
      "type": "string",
      "enum": [
        "optional",
        "required"
      ]
    },
    "independent_reviews": {
      "type": "boolean",
      "const": true
    },
    "completion": {
      "const": "fresh_full_conformance",
      "type": "string"
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replanning", "revision_mode", "failure_policy", "cancellation"],
      "properties": {
        "replanning": {"const": "continuous", "type": "string"},
        "revision_mode": {"const": "checkpointed", "type": "string"},
        "failure_policy": {"const": "rsi_decides", "type": "string"},
        "cancellation": {"const": "policy_defined", "type": "string"}
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conformance",
        "collate",
        "select",
        "planning",
        "plan_review",
        "implementation",
        "implementation_review"
      ],
      "properties": {
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions",
            "skill"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "PASS",
                "FINDINGS",
                "BLOCKED"
              ],
              "properties": {
                "PASS": {
                  "const": "done",
                  "type": "string"
                },
                "FINDINGS": {
                  "const": "collate",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "collate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions",
            "skill"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "COLLATED",
                "BLOCKED"
              ],
              "properties": {
                "COLLATED": {
                  "const": "select",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions",
            "skill"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "SELECTED",
                "BLOCKED"
              ],
              "properties": {
                "SELECTED": {
                  "const": "planning",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions",
            "skill"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "PLANNED",
                "BLOCKED"
              ],
              "properties": {
                "PLANNED": {
                  "const": "plan_review",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "plan_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions",
            "skill"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ACCEPT",
                "REJECT",
                "BLOCKED"
              ],
              "properties": {
                "ACCEPT": {
                  "const": "implementation",
                  "type": "string"
                },
                "REJECT": {
                  "const": "planning",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            },
            "skill": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "IMPLEMENTED",
                "BLOCKED"
              ],
              "properties": {
                "IMPLEMENTED": {
                  "const": "implementation_review",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            }
          }
        },
        "implementation_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "transitions"
          ],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "transitions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ACCEPT_IMPLEMENTATION",
                "REJECT_IMPLEMENTATION",
                "BLOCKED"
              ],
              "properties": {
                "ACCEPT_IMPLEMENTATION": {
                  "const": "accepted",
                  "type": "string"
                },
                "REJECT_IMPLEMENTATION": {
                  "const": "planning",
                  "type": "string"
                },
                "BLOCKED": {
                  "const": "blocked",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[A-Za-z][A-Za-z0-9_-]*$|^session\\.[A-Za-z][A-Za-z0-9_-]*$"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "agent", "depends_on", "inputs", "outputs", "read_scope", "write_scope", "resources"],
      "properties": {
        "kind": {"enum": ["agent_task", "command", "control"], "type": "string"},
        "agent": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "skill": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "uniqueItems": true},
        "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/port"}},
        "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/port"}},
        "read_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "write_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
