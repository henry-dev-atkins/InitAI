prefix_rule(
    pattern = ["./tools/write_ai_space_artifact.ps1"],
    decision = "allow",
    justification = "Repo-local AI_SPACE orchestration writer with internal path checks for sessions, handovers, TODO and learnings only.",
    match = [
        "./tools/write_ai_space_artifact.ps1 -Path AI_SPACE/sessions/session__YYYYMMDD_HHMMSS/session_board.md -Mode create -ContentBase64 SGVsbG8=",
        "./tools/write_ai_space_artifact.ps1 -Path AI_SPACE/handovers/session__YYYYMMDD_HHMMSS__session_end.md -Mode create -ContentBase64 SGVsbG8=",
        "./tools/write_ai_space_artifact.ps1 -Path AI_SPACE/TODO.md -Mode append -ContentBase64 SGVsbG8=",
    ],
    not_match = [
        "Set-Content AI_SPACE/sessions/session__YYYYMMDD_HHMMSS/session_board.md",
        "./tools/write_ai_space_artifact.cmd -Path AI_SPACE/TODO.md -Mode append -ContentBase64 SGVsbG8=",
    ],
)
