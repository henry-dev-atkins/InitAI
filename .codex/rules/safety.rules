prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "Never delete files. Move unwanted files into archive/ instead.",
    match = [
        "rm file.py",
        "rm -rf outputs/",
    ],
)

prefix_rule(
    pattern = ["rmdir"],
    decision = "forbidden",
    justification = "Never delete folders. Move unwanted folders into archive/ instead.",
    match = [
        "rmdir old_folder",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Do not delete untracked files. Inspect and archive clutter instead.",
    match = [
        "git clean -fd",
        "git clean -xdf",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard repo state. Revert deliberately or ask the human.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "forbidden",
    justification = "Do not discard shared-checkout work with git restore. Handle rejected work through an accepted plan.",
    match = [
        "git restore file.py",
        "git restore .",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Do not discard shared-checkout work with path checkout. Handle rejected work through an accepted plan.",
    match = [
        "git checkout -- file.py",
        "git checkout -- .",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Do not push remote changes from agent sessions unless explicitly authorised by the human.",
    match = [
        "git push",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not escalate privileges from agent sessions.",
    match = [
        "sudo apt install foo",
        "sudo rm -rf /tmp/foo",
    ],
)

prefix_rule(
    pattern = ["chmod", "-R"],
    decision = "forbidden",
    justification = "Recursive permission changes are outside the focused repository workflow.",
    match = [
        "chmod -R 777 .",
        "chmod -R u+w outputs/",
    ],
)

prefix_rule(
    pattern = ["uv", "add"],
    decision = "allow",
    justification = "Repo-local dependency changes are allowed only when justified by an accepted workstream plan. Network policy remains unchanged.",
    match = [
        "uv add numpy",
        "uv add --dev pytest",
        "uv add ruff pytest",
    ],
)

prefix_rule(
    pattern = ["pip", "install"],
    decision = "forbidden",
    justification = "Do not mutate the environment with pip install; declare dependencies through the repository dependency manager.",
    match = [
        "pip install numpy",
        "pip install -r requirements.txt",
    ],
)

prefix_rule(
    pattern = ["uv", "pip", "install"],
    decision = "forbidden",
    justification = "Do not mutate the environment with uv pip install; use declared repository dependencies.",
    match = [
        "uv pip install numpy",
        "uv pip install -r requirements.txt",
    ],
)
