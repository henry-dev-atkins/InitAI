prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Safe repository inspection for orchestration and review.",
    match = ["git status", "git status --short", "git status --short --branch"],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Safe diff inspection for scope and integration review.",
    match = ["git diff", "git diff --stat", "git diff -- AGENTS.md"],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Safe commit history inspection.",
    match = ["git log --oneline", "git log --oneline -5"],
)

prefix_rule(
    pattern = ["git", "branch", "--show-current"],
    decision = "allow",
    justification = "Safe current-branch inspection.",
    match = ["git branch --show-current"],
)

prefix_rule(
    pattern = ["git", "worktree", "list"],
    decision = "allow",
    justification = "Safe worktree inspection.",
    match = ["git worktree list", "git worktree list --porcelain"],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Local staging is reversible and is performed only after orchestrator review.",
    match = ["git add AGENTS.md", "git add ."],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "One final local commit is allowed after validation and integration review.",
    match = ["git commit -m 'FIX: example'"],
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "forbidden",
    justification = "The orchestrator workflow uses one session checkout. Start a separate top-level Codex worktree chat for isolated branch work.",
    match = ["git switch main", "git switch -c codex/P001-example"],
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "forbidden",
    justification = "Do not change branches or discard paths inside a shared orchestrator session checkout.",
    match = ["git checkout main", "git checkout -- file.py"],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "remove", "move", "prune"]],
    decision = "forbidden",
    justification = "Nested worktree management is not part of this workflow. Use separate top-level Codex app worktree chats instead.",
    match = ["git worktree add ../repo-P001 codex/P001-example", "git worktree remove ../repo-P001"],
)

prefix_rule(
    pattern = ["git", ["merge", "rebase"]],
    decision = "forbidden",
    justification = "Subagents share one checkout, so no worker-branch merge or rebase should occur.",
    match = ["git merge codex/P001-example", "git rebase main"],
)
