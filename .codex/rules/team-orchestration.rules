prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Safe repository inspection for orchestration and review.",
    match = ["git status", "git status --short", "git status --short --branch"],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Safe diff inspection for scope and integration review.",
    match = ["git diff", "git diff --stat", "git diff -- AGENTS.md"],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Safe commit history inspection.",
    match = ["git log --oneline", "git log --oneline -5"],
)

prefix_rule(
    pattern = ["git", "branch", "--show-current"],
    decision = "allow",
    justification = "Safe current-branch inspection.",
    match = ["git branch --show-current"],
)

prefix_rule(
    pattern = ["git", "worktree", "list"],
    decision = "allow",
    justification = "Safe worktree inspection.",
    match = ["git worktree list", "git worktree list --porcelain"],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Workers may stage changes during orchestrated work.",
    match = ["git add AGENTS.md", "git add ."],
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "allow",
    justification = "Safe local branch work is allowed when the accepted plan or session policy authorises it.",
    match = ["git switch main", "git switch -c codex/P001-example"],
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "allow",
    justification = "Safe local checkout work is allowed. Path discard remains blocked by safety rules.",
    match = ["git checkout main", "git checkout -- file.py"],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "remove", "move", "prune"]],
    decision = "allow",
    justification = "Safe local worktree work is allowed when the accepted plan or session policy authorises it.",
    match = ["git worktree add ../repo-P001 codex/P001-example", "git worktree remove ../repo-P001"],
)

prefix_rule(
    pattern = ["git", ["merge", "rebase"]],
    decision = "allow",
    justification = "Safe local merge and rebase work is allowed when the accepted plan or session policy authorises it.",
    match = ["git merge codex/P001-example", "git rebase main"],
)
